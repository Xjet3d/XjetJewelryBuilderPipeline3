# Nightly backup of XJet Atelier's databases and assets (scripts/backup.sh) — started by xjet-atelier-backup.timer.
#   sudo systemctl daemon-reload && sudo systemctl enable --now xjet-atelier-backup.timer
[Unit]
Description=XJet Atelier backup (databases + assets)
After=xjet-atelier.service

[Service]
Type=oneshot
User=atelier
Group=atelier
WorkingDirectory=/srv/atelier/app
EnvironmentFile=/etc/xjet-atelier/env
Environment=P3_BACKUP_DIR=/srv/atelier/backups
ExecStart=/usr/bin/bash /srv/atelier/app/scripts/backup.sh
