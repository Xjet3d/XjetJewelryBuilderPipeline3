# Checks GitHub every 2 minutes; a deploy happens only when atelier-production moved, which needs the owner's
# approval (main never reaches atelier; see scripts/auto-deploy-atelier.sh and deploy/README.md).
[Unit]
Description=XJet Atelier Pipeline 3 auto-deploy check

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
