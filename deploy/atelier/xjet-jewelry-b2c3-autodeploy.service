# Auto-deploy of Pipeline 3 on atelier (user unit) — started by xjet-jewelry-b2c3-autodeploy.timer.
# Install: cp deploy/atelier/xjet-jewelry-b2c3-autodeploy.{service,timer} ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now xjet-jewelry-b2c3-autodeploy.timer
[Unit]
Description=XJet Atelier Pipeline 3: deploy GitHub main when it moved

[Service]
Type=oneshot
ExecStart=%h/git/XjetJewelryBuilderPipeline3/scripts/auto-deploy-atelier.sh
