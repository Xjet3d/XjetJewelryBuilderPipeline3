# Pipeline 3 configuration. Copy to .env (gitignored) and fill in. Placeholders only.

# "mock" (default, no network, no cost) or "fal" (live, paid provider calls).
P3_PROVIDER=mock
# Required only when P3_PROVIDER=fal. Use a Pipeline 3 test key with a spending limit.
FAL_KEY=

# Enables /dev developer mesh tools when set. Use a long random value.
P3_ADMIN_KEY=

# Runtime data (SQLite DB, generated assets). Default: ./var in this repository.
# P3_DATA_DIR=./var

# Pricing profile. The shipped default has no approved prices (fashion shows "Price unavailable").
# P3_PRICING_PROFILE=config/pricing_profile.json
# Development only: honour an unapproved profile such as config/pricing_profile.dev-example.json.
# P3_ALLOW_UNAPPROVED_PRICING=false

# Mock provider latency per request (seconds), to make loading states visible.
# P3_MOCK_LATENCY_S=1.5

# URL prefix. Deployment behind proto/tron uses /JewelryB2C3 (everything — pages, API,
# static files, generated assets, /dev — is then served under it, and / redirects there).
# Leave empty to serve at the site root (http://localhost:8310/).
# P3_BASE_PATH=/JewelryB2C3

# Account/token provider. Only "local" (P3's own var/accounts.db) exists today; see docs/ACCOUNTS.md.
# P3_ACCOUNT_PROVIDER=local

# Registration email. "outbox" (default, local dev) records messages in var/outbox/ and sends nothing;
# "smtp" (deployed) sends through P2's relay (SMTP_SERVER, SMTP_PORT, MAIL_FROM) and also records them.
# Either way they are listed at /api/dev/outbox (admin key).
# P3_MAIL_MODE=outbox
# Public origin used in email/verify links when the app sits behind a proxy, e.g. http://proto
# P3_PUBLIC_BASE_URL=

# ── Sign-in (AJW-39, docs/AUTH-OPERATIONS-AJW-39.md) ──
# legacy = the old six-letter-code sign-in only · dual = sessions and codes · modern = sessions only (the code is exchanged once, /api/auth/claim)
# P3_AUTH_MODE=dual
# Google: an OAuth "Web application" client; Apple: a Services ID, its team id, a Sign in with Apple key id and the .p8 private key.
# A provider without credentials simply does not appear on the sign-in page.
# P3_GOOGLE_CLIENT_ID=
# P3_GOOGLE_CLIENT_SECRET=
# P3_APPLE_CLIENT_ID=
# P3_APPLE_TEAM_ID=
# P3_APPLE_KEY_ID=
# P3_APPLE_PRIVATE_KEY_PATH=
# The Admin opens only for operator-enrolled Google / Apple identities (python -m p3.cli admin-enroll); the shared key then stays a CLI break-glass.
# P3_ADMIN_IDENTITY_ENFORCED=false

# SSH-tunnel Admin (no public admin host): where Admin sign-in returns to. Register the same address with Google.
# P3_ADMIN_BASE_URL=http://localhost:8340

# The XJet Atelier Fulfillment integration (docs/FULFILLMENT.md). Off by default: nothing changes while it is off.
# P3_FULFILLMENT_INTEGRATION=false
# The service credential Fulfillment presents (16+ characters; never the admin key). Required when the integration is on.
# P3_FULFILLMENT_SERVICE_KEY=
# Customer emails derived from Fulfillment's milestones (approved / changes required / in production / shipped / delivered).
# Off by default: the intents are recorded but nothing is sent. With a recipient set, every message goes there instead of to customers.
# P3_FULFILLMENT_CUSTOMER_NOTIFICATIONS=false
# P3_FULFILLMENT_NOTIFICATION_RECIPIENT=
# P3_FULFILLMENT_NOTIFICATION_WINDOW_S=120
# The payment rule Atelier advertises to Fulfillment (docs/order-to-production-review.md §J). true (default): an unpaid order's lines
# are not released and the live checks say PAYMENT_PENDING. false: payment is shown, never gating — the Admin decides what enters
# Production (complimentary samples, internal evaluations). Switched to false at the integration's activation, not before.
# P3_FULFILLMENT_PAYMENT_GATE=true
# The controlled phase: while set, only these orders (ids or references, comma-separated) can be sent to Production — the
# server's rule, not the page's. Empty (default): every eligible order.
# P3_FULFILLMENT_ORDER_ALLOWLIST=
# The Fulfillment application's URL for the Production page's "Open in Fulfillment" links.
# P3_FULFILLMENT_URL=
