# Runtime data — Pipeline 3 only, never committed
var/
*.db
*.db-wal
*.db-shm
*.log

# Secrets / local config — and any copy of them (an .env backup in a server checkout must never be one git add away
# from this public repository)
.env
.env.*
!.env.example
!.env.*.example
*.bak
*.bak-*
*.secret
backups/
*.priv
*.key
config/pricing_profile.local.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# atelier auto-deploy state (scripts/auto-deploy-atelier.sh)
.auto-deploy.lock
.auto-deploy.bad
