# XJet Atelier — production configuration TEMPLATE (docs/PRODUCTION-READINESS-HANDOFF.md, section "Environment").
# Copy to /etc/xjet-atelier/env (mode 0640 root:atelier), fill every REQUIRED value, never commit the filled file.
# Placeholders are marked <…>; the service refuses to start while any REQUIRED value is missing or a development default.
# Secrets (marked SECRET) are generated with:  python3 -c "import secrets; print(secrets.token_urlsafe(36))"

# ── posture ──────────────────────────────────────────────────────────────────
P3_ENV=production                                   # REQUIRED. production: validates everything below, locks the AI mode, no dev tools
P3_PUBLIC_BASE_URL=https://xjetatelier.xjet3d.com      # REQUIRED. The customer site's https origin (emails, share links, sitemap, OG tags)
P3_ADMIN_HOST=admin.atelier.xjet3d.com              # REQUIRED. The Admin, its API and nothing else answer on this host only
P3_BASE_PATH=                                       # REQUIRED empty in production (the site lives at the root of its host)
P3_DATA_DIR=/srv/atelier/data                       # REQUIRED, outside the checkout: pipeline3.db, accounts.db, assets/, outbox/

# ── secrets ──────────────────────────────────────────────────────────────────
P3_ADMIN_KEY=<random 24+ characters>                # REQUIRED, SECRET. The Admin sign-in key (Admin → sign in)
P3_SIGNING_SECRET=<another random 24+ characters>   # REQUIRED, SECRET. Signs download links; must differ from the admin key
FAL_KEY=<fal.ai API key>                            # REQUIRED, SECRET. fal.ai (image, movie and 3D models); provider: fal.ai
P3_PROVIDER=fal                                     # REQUIRED. fal in production (never mock)

# ── money ────────────────────────────────────────────────────────────────────
P3_DAILY_AI_SPEND_CAP_USD=<e.g. 50>                 # REQUIRED. Paid AI submissions stop for the day at this estimated spend (Admin → Settings → System can set another amount)
P3_ALLOW_UNAPPROVED_PRICING=false                   # REQUIRED false. Customers see approved prices only (config/pricing_profile.json, approved)
P3_PAYMENT_PROVIDER=none                            # Only "none" exists: orders are reservations, payment is arranged by XJet (handoff: decision)

# ── mail ─────────────────────────────────────────────────────────────────────
P3_MAIL_MODE=smtp                                   # REQUIRED smtp (outbox sends nothing)
SMTP_SERVER=<relay host>                            # REQUIRED. e.g. the company's Exchange Online relay; provider: Microsoft 365
SMTP_PORT=25                                        # Optional (default 25)
SMTP_PREFER_IPV4=true                               # Optional (default true)
MAIL_FROM=<no-reply@xjet3d.com>                     # REQUIRED. The sender; the relay must allow it
MAIL_FROM_NAME=XJet Atelier                         # Optional
MAIL_REPLY_TO=                                      # Optional. Where replies go; unset = the support address
P3_SUPPORT_EMAIL=                                   # Optional. Contact page, Contact Us and the emails; unset = atelier@xjet3d.com (the shared inbox)
P3_STAFF_NOTIFY_EMAILS=                             # Optional. Who hears of new orders / quote requests (comma-separated); unset = the support address, none = nobody

# ── XJet Atelier Fulfillment (docs/FULFILLMENT.md) ───────────────────────────
P3_FULFILLMENT_INTEGRATION=false                    # Optional (default false). true only once Fulfillment is deployed and the owner approved the hand-over
P3_FULFILLMENT_SERVICE_KEY=                         # SECRET, required when the integration is on: 24+ characters, different from the admin key and the signing secret
P3_FULFILLMENT_CUSTOMER_NOTIFICATIONS=false         # Optional (default false). Customer emails from Fulfillment's milestones: ON only with the owner's explicit activation
P3_FULFILLMENT_NOTIFICATION_RECIPIENT=              # Optional. While set, every such email goes to this address instead of the customer (required in production while sending is on)
P3_FULFILLMENT_NOTIFICATION_WINDOW_S=120            # Optional (default 120). Parts of one order reaching a milestone within this window make one email
P3_FULFILLMENT_PAYMENT_GATE=true                    # Optional (default true). false at the integration's activation (K8): payment shown to Fulfillment, never gating production
P3_FULFILLMENT_ORDER_ALLOWLIST=                     # The controlled phase: only these orders (ids or references, comma-separated) can be sent to Production. Empty: every eligible order
P3_FULFILLMENT_URL=                                 # Optional. The Fulfillment application's URL for the Production page's "Open in Fulfillment" links (e.g. https://tron/atelier-fulfillment)

# ── protection ───────────────────────────────────────────────────────────────
P3_RATE_LIMITS=true                                 # Optional (default true): per-IP / per-account request limits
P3_LOCK_MODE=true                                   # Implied by production: the developer AI-mode switch is refused
P3_NO_DEV_TOOLS=true                                # Implied by production

# ── tuning (optional; the defaults are the tested ones) ──────────────────────
P3_POLL_INTERVAL_S=2.0
P3_MAX_TRANSIENT_POLL_ERRORS=10
P3_ACCOUNT_PROVIDER=local
P3_PRICING_PROFILE=config/pricing_profile.json      # The approved price profile (Admin → Pricing & Materials)

# ── sign-in and administrator access (AJW-39; docs/AUTH-OPERATIONS-AJW-39.md) ─────────────────────────────────
P3_AUTH_MODE=dual                                   # REQUIRED dual or modern. dual = sessions beside the old six-letter codes (the rollout step); modern = sessions only
P3_GOOGLE_CLIENT_ID=<…apps.googleusercontent.com>   # Google OAuth web client. Redirect URIs: https://xjetatelier.xjet3d.com/api/auth/google/callback and https://<P3_ADMIN_HOST>/api/admin/auth/google/callback
P3_GOOGLE_CLIENT_SECRET=<secret>                    # SECRET
P3_APPLE_CLIENT_ID=<com.xjet.atelier.web>           # Apple Services ID. Return URLs: https://xjetatelier.xjet3d.com/api/auth/apple/callback and https://<P3_ADMIN_HOST>/api/admin/auth/apple/callback
P3_APPLE_TEAM_ID=<10 characters>
P3_APPLE_KEY_ID=<10 characters>
P3_APPLE_PRIVATE_KEY_PATH=/etc/xjet-atelier/apple-signin.p8   # SECRET file (0640 root:atelier)
P3_ADMIN_IDENTITY_ENFORCED=false                    # Set true only after both administrators are enrolled and have signed in once (docs/AUTH-OPERATIONS-AJW-39.md §6); REQUIRED true with P3_AUTH_MODE=modern

# SSH-tunnel Admin (no public admin host): where Admin sign-in returns to. Register the same address with Google.
# P3_ADMIN_BASE_URL=http://localhost:8340
