# XJet Atelier — production configuration TEMPLATE (docs/PRODUCTION-READINESS-HANDOFF.md, section "Environment").
# Copy to /etc/xjet-atelier/env (mode 0640 root:atelier), fill every REQUIRED value, never commit the filled file.
# Placeholders are marked <…>; the service refuses to start while any REQUIRED value is missing or a development default.
# Secrets (marked SECRET) are generated with:  python3 -c "import secrets; print(secrets.token_urlsafe(36))"

# ── posture ──────────────────────────────────────────────────────────────────
P3_ENV=production                                   # REQUIRED. production: validates everything below, locks the AI mode, no dev tools
P3_PUBLIC_BASE_URL=https://atelier.xjet3d.com       # REQUIRED. The customer site's https origin (emails, share links, sitemap, OG tags)
P3_ADMIN_HOST=admin.atelier.xjet3d.com              # REQUIRED. The Admin, its API and nothing else answer on this host only
P3_BASE_PATH=                                       # REQUIRED empty in production (the site lives at the root of its host)
P3_DATA_DIR=/srv/atelier/data                       # REQUIRED, outside the checkout: pipeline3.db, accounts.db, assets/, outbox/

# ── secrets ──────────────────────────────────────────────────────────────────
P3_ADMIN_KEY=<random 24+ characters>                # REQUIRED, SECRET. The Admin sign-in key (Admin → sign in)
P3_SIGNING_SECRET=<another random 24+ characters>   # REQUIRED, SECRET. Signs download links; must differ from the admin key
FAL_KEY=<fal.ai API key>                            # REQUIRED, SECRET. fal.ai (image, movie and 3D models); provider: fal.ai
P3_PROVIDER=fal                                     # REQUIRED. fal in production (never mock)

# ── money ────────────────────────────────────────────────────────────────────
P3_DAILY_AI_SPEND_CAP_USD=<e.g. 50>                 # REQUIRED. Paid AI submissions stop for the day at this estimated spend
P3_ALLOW_UNAPPROVED_PRICING=false                   # REQUIRED false. Customers see approved prices only (config/pricing_profile.json, approved)
P3_PAYMENT_PROVIDER=none                            # Only "none" exists: orders are reservations, payment is arranged by XJet (handoff: decision)

# ── mail ─────────────────────────────────────────────────────────────────────
P3_MAIL_MODE=smtp                                   # REQUIRED smtp (outbox sends nothing)
SMTP_SERVER=<relay host>                            # REQUIRED. e.g. the company's Exchange Online relay; provider: Microsoft 365
SMTP_PORT=25                                        # Optional (default 25)
SMTP_PREFER_IPV4=true                               # Optional (default true)
MAIL_FROM=<no-reply@xjet3d.com>                     # REQUIRED. The sender; the relay must allow it
MAIL_FROM_NAME=XJet Atelier                         # Optional
MAIL_REPLY_TO=<a read mailbox, e.g. atelier@xjet3d.com>   # Optional but recommended: where replies go; else the mail names P3_SUPPORT_EMAIL
P3_SUPPORT_EMAIL=<the confirmed support address>    # REQUIRED. Shown on the Contact page and in emails — confirm it, never invent it
P3_STAFF_NOTIFY_EMAILS=<orders@…,sales@…>           # Optional. Who is emailed about a new order / quote request (comma-separated)

# ── protection ───────────────────────────────────────────────────────────────
P3_RATE_LIMITS=true                                 # Optional (default true): per-IP / per-account request limits
P3_LOCK_MODE=true                                   # Implied by production: the developer AI-mode switch is refused
P3_NO_DEV_TOOLS=true                                # Implied by production

# ── tuning (optional; the defaults are the tested ones) ──────────────────────
P3_POLL_INTERVAL_S=2.0
P3_MAX_TRANSIENT_POLL_ERRORS=10
P3_ACCOUNT_PROVIDER=local
P3_PRICING_PROFILE=config/pricing_profile.json      # The approved price profile (Admin → Pricing & Materials)
